PORT=5000
DB_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/yourtube
JWT_SECRET=your_super_secret_key
MOCK_PAYMENTS=true
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=youremail@gmail.com
MAIL_PASS=your_smtp_app_password
MAIL_FROM=YourTube <youremail@gmail.com>
# Brevo transactional email (optional). If BREVO_API_KEY is set it takes priority over SMTP.
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxx
BREVO_FROM_EMAIL=youremail@gmail.com
BREVO_FROM_NAME=YourTube