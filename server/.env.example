PORT=5000
DB_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/yourtube
JWT_SECRET=your_super_secret_key
MOCK_PAYMENTS=true
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Firebase project used to verify the browser's ID token on login.
# The backend takes the user's email from this signed token, never from the body.
FIREBASE_PROJECT_ID=your_firebase_project_id

# OTP email delivery. SMTP is used first when MAIL_USER + MAIL_PASS are set.
# For Gmail, MAIL_PASS must be a 16-character App Password (not the account password).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=youremail@gmail.com
MAIL_PASS=your_16_char_app_password
MAIL_FROM=YourTube <youremail@gmail.com>

# Brevo transactional email. Only used when SMTP is not configured. Brevo errors
# are never treated as success, and a failed send is surfaced as a 502.
# BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxx
# BREVO_FROM_EMAIL=youremail@gmail.com
# BREVO_FROM_NAME=YourTube

# Optional OTP tuning (defaults shown). TTL is 300 seconds = 5 minutes.
# OTP_TTL_SECONDS=300
# OTP_MAX_ATTEMPTS=5
# OTP_RESEND_COOLDOWN_SECONDS=60
# OTP_MAX_SENDS_PER_HOUR=5
# OTP_SECRET=optional_separate_pepper_for_otp_hashes

# Set to true only when the app runs behind a proxy/load balancer with a public
# address, so X-Forwarded-For is honoured for geolocation.
# TRUST_PROXY=false

# Comma-separated emails allowed to review flagged comments.
ADMIN_EMAILS=youremail@gmail.com

# Number of unique reports before a comment is flagged for review.
# Flagged comments stay visible; nothing is deleted automatically.
COMMENT_REPORT_FLAG_THRESHOLD=3

# Optional extra abusive words/phrases, comma separated.
# ABUSIVE_WORDS=

# Optional self-hosted LibreTranslate fallback. Google and MyMemory are tried
# automatically when these are not set.
# TRANSLATE_API_URL=https://libretranslate.example.com
# TRANSLATE_API_KEY=
